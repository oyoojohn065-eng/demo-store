# Copy this file to ".env" and fill in your real values.
# PostgreSQL connection. Replace YOUR_PASSWORD with your postgres user password.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/demo_store?schema=public"

# Password that protects the /admin area. Change this to something strong.
ADMIN_PASSWORD="change-me"

# --- M-Pesa (Safaricom Daraja API) ---
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"
MPESA_PASSKEY=""
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"
MPESA_CALLBACK_URL=""
